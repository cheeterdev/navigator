{
  "name": "cheeternavigator",
  "productName": "Cheeter Navigator",
  "desktopName": "de.cheeter.navigator",
  "version": "2.0.0",
  "description": "A whole different browsing experience.",
  "homepage": "https://navigator.cheeter.de",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "pack": "npm run package && electron-builder --dir",
    "dist": "npm run package && electron-builder",
    "dist:mac": "npm run package && electron-builder --mac",
    "dist:win": "npm run package && electron-builder --win",
    "dist:linux": "npm run package && electron-builder --linux",
    "dist:all": "npm run package && electron-builder --mac --win --linux",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder"
  },
  "keywords": [],
  "author": {
    "name": "Cheeter",
    "email": "hello@cheeter.de"
  },
  "license": "CSAL",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.14.1",
    "electron-squirrel-startup": "^1.0.1"
  },
  "build": {
    "appId": "de.cheeter.navigator",
    "productName": "Cheeter Navigator",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      ".vite/**",
      "package.json",
      "index.html",
      "public/**",
      "src/**"
    ],
    "protocols": [
      {
        "name": "navigator",
        "schemes": [
          "navigator"
        ]
      },
      {
        "name": "http(s)",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "role": "Viewer",
        "mimeType": "text/html"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "internet",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "postinstall": "electron-builder install-app-deps"
}
